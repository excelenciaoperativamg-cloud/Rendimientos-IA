function guardarRegistrosAprobados(registros) {
  if (!Array.isArray(registros) || registros.length === 0) {
    throw new Error('No hay registros para guardar.');
  }

  const ss = SpreadsheetApp.openById(ID_ARCHIVO);
  
  const hoja = ss.getSheetByName('Rendimientos');

  if (!hoja) throw new Error('No existe la hoja Rendimientos.');

  const encabezados = hoja.getRange(
    1, 1, 1, hoja.getLastColumn()
  ).getDisplayValues()[0];

  const catalogos = obtenerCatalogos();
  const normalizar = v => String(v ?? '').trim().toUpperCase();

  const areas = new Map(catalogos.areas.map(a => [
    normalizar(a.AreSup),
    { sede: a.Sede, producto: a.Producto }
  ]));

  const personas = new Map(catalogos.colaboradores.map(p => [
    normalizar(p['Código']),
    normalizar(p.Nombre)
  ]));

  const requeridos = [
    'Id_Captura', 'Sede', 'AreSup', 'Producto', 'Código',
    'Colaborador', 'Fecha', 'Año', 'Sem', 'Hora Inicio',
    'Hora Fin', 'Duración', 'Total Tallos', 'Rendimiento Hora'
  ];

  if (requeridos.some(c => !encabezados.includes(c))) {
    throw new Error('Verifica los encabezados de Rendimientos.');
  }

  const zona = ss.getSpreadsheetTimeZone();
  const semanaRegex = /^(\d{2})(\d{2})$/;
  const filas = [];

  registros.forEach(r => {
    const id = normalizar(r['Código']);
    const nombre = normalizar(r.Colaborador);
    const area = normalizar(r.AreSup);
    const catArea = areas.get(area);

    if (!catArea) throw new Error('Área no encontrada: ' + area);
    if (!id || personas.get(id) !== nombre) {
      throw new Error('Código y nombre no coinciden con Maestro: ' + id);
    }

    const m = String(r.Sem || '').match(semanaRegex);
    if (!m) throw new Error('La semana debe tener formato AASS, por ejemplo 2641.');

    const anio = 2000 + Number(m[1]);
    const numSemana = Number(m[2]);
    if (numSemana < 1 || numSemana > 53) {
      throw new Error('Número de semana inválido.');
    }

    // Semana empresarial: domingo a sábado.
    // La semana 1 es la que contiene el 1 de enero.
    const primero = new Date(anio, 0, 1, 12);
    const domingoInicial = new Date(primero);
    domingoInicial.setDate(
      primero.getDate() - primero.getDay() + (primero.getDay() === 0 ? 0 : 0)
    );

    const domingo = new Date(domingoInicial);
    domingo.setDate(domingoInicial.getDate() + (numSemana - 1) * 7);

    const fechaTexto = String(r.Fecha || '');
    const fechaPartes = fechaTexto.match(/^(\d{4})-(\d{2})-(\d{2})$/);
    if (!fechaPartes) throw new Error('Fecha inválida: usa AAAA-MM-DD.');

    const fecha = new Date(
      Number(fechaPartes[1]),
      Number(fechaPartes[2]) - 1,
      Number(fechaPartes[3]),
      12
    );

    const diferencia = Math.floor(
      (fecha.getTime() - domingo.getTime()) / 86400000
    );

    if (diferencia < 0 || diferencia > 6 ||
        fecha.getFullYear() !== anio) {
      throw new Error('La fecha no corresponde a la semana indicada: ' + r.Fecha);
    }

    const leerHora = valor => {
      const p = String(valor || '').match(/^(\d{1,2}):(\d{2})$/);
      if (!p || Number(p[1]) > 23 || Number(p[2]) > 59) {
        throw new Error('Hora inválida: ' + valor);
      }
      return Number(p[1]) * 60 + Number(p[2]);
    };

    const minInicio = leerHora(r['Hora Inicio']);
    const minFin = leerHora(r['Hora Fin']);

    if (minFin <= minInicio) {
      throw new Error('Hora Fin debe ser posterior a Hora Inicio para ' + nombre);
    }

    const duracion = (minFin - minInicio) / 60;
    const tallos = Number(r['Total Tallos']);

    if (!Number.isFinite(tallos) || tallos < 0) {
      throw new Error('Total Tallos inválido para ' + nombre);
    }

    const horaComoFecha = minutos => {
      const d = new Date(fecha);
      d.setHours(Math.floor(minutos / 60), minutos % 60, 0, 0);
      return d;
    };

    const valores = {
      Id_Captura: Utilities.getUuid(),
      Sede: catArea.sede,
      AreSup: area,
      Producto: catArea.producto,
      'Código': id,
      Colaborador: nombre,
      Fecha: fecha,
      Año: anio,
      Sem: r.Sem,
      'Hora Inicio': horaComoFecha(minInicio),
      'Hora Fin': horaComoFecha(minFin),
      Duración: duracion,
      'Total Tallos': tallos,
      'Rendimiento Hora': duracion > 0 ? tallos / duracion : 0
    };

    filas.push(encabezados.map(h => valores[h] ?? ''));
  });

  const bloqueo = LockService.getScriptLock();
  bloqueo.waitLock(30000);

  try {

const filaInicial = hoja.getLastRow() + 1;

hoja.getRange(
  filaInicial, 1, filas.length, encabezados.length
).setValues(filas);

// Mostrar la columna Fecha únicamente como día/mes/año.
const columnaFecha = encabezados.indexOf('Fecha') + 1;

hoja.getRange(
  filaInicial, columnaFecha, filas.length, 1
).setNumberFormat('d/M/yyyy');

  } finally {
    bloqueo.releaseLock();
  }

  return { guardados: filas.length };
}
