      La hora inicial se asigna a las 06:00.
      La fecha y la semana deben corresponder al formato.
    </p>
    <button type="button" onclick="agregarFila()">+ Agregar colaborador</button>
  </div>

  <div class="panel">
    <h2>3. Revisar los registros</h2>
    <p class="note">
      Verifica el nombre, el área, la hora final y el total de tallos
      antes de guardar.
    </p>
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>Código</th>
            <th>Colaborador</th>
            <th>Área</th>
            <th>Hora inicio</th>
            <th>Hora fin</th>
            <th>Total tallos</th>
            <th>Duración (h)</th>
            <th>Rendimiento/h</th>
            <th></th>
          </tr>
        </thead>
        <tbody id="rows"></tbody>
      </table>
    </div>
    <button type="button" onclick="agregarFila()">+ Agregar fila</button>
    <button id="save" type="button" onclick="guardar()">Guardar registros aprobados</button>
    <button class="secondary" type="button" onclick="cargarCatalogos()">Actualizar catálogos</button>
    <div id="status" role="status">Conectando con Google Sheets...</div>
  </div>

<script>
let areas = [];
let personas = [];

const esc = v => String(v ?? '').replace(/[&<>"']/g, c => ({
  '&':'&amp;', '<':'&lt;', '>':'&gt;',
  '"':'&quot;', "'":'&#39;'
}[c]));

function mensaje(texto) {
  document.getElementById('status').textContent = texto;
}

function convertirImagenBase64(file) {
  return new Promise((resolve, reject) => {
    const reader = new FileReader();

    reader.onload = () => {
      const resultado = String(reader.result);
      const separador = resultado.indexOf(',');

      if (separador < 0) {
        reject(new Error('No se pudo leer la fotografía.'));
        return;
      }

      resolve({
        mimeType: file.type,
        data: resultado.substring(separador + 1)
      });
    };

    reader.onerror = () => reject(
      new Error('Error al cargar ' + file.name)
    );

    reader.readAsDataURL(file);
  });
}

async function leerFotografias() {
  const archivos = [
    ...document.getElementById('photos').files
  ];

  if (!archivos.length) {
    mensaje('Primero selecciona una o varias fotografías.');
    return;
  }

  if (archivos.length > 6) {
    mensaje('Selecciona máximo 6 fotografías por lectura.');
    return;
  }

  const boton = document.getElementById('readPhotos');
  boton.disabled = true;
  mensaje('Leyendo fotografías. Espera unos momentos...');

  try {
    const imagenes = await Promise.all(
      archivos.map(convertirImagenBase64)
    );

    google.script.run
      .withSuccessHandler(datos => {
        boton.disabled = false;
        cargarRegistrosReconocidos(datos);
      })
      .withFailureHandler(error => {
        boton.disabled = false;
        mensaje('No se pudieron leer las fotografías: ' + error.message);
      })
      .leerFotografiasGemini(imagenes);

  } catch (error) {
    boton.disabled = false;
    mensaje('Error al preparar las fotografías: ' + error.message);
  }
}

function obtenerCodigoArea(valor) {
  return String(valor || '').split('-')[0].trim();
}

function cargarCatalogos() {
  mensaje('Prueba 1: iniciando conexión...');

  if (typeof google === 'undefined' ||
      !google.script ||
      !google.script.run) {
    mensaje(
      'Error: esta página no está ejecutándose dentro de Google Apps Script.'
    );
    return;
  }

  mensaje('Prueba 2: Google Apps Script disponible. Consultando catálogos...');

  let respondio = false;

  google.script.run
    .withSuccessHandler(data => {
      respondio = true;

      areas = data.areas || [];
      personas = data.colaboradores || [];

      document.querySelectorAll('.area').forEach(select => {
        const valor = select.value;
        select.innerHTML = opcionesAreas(valor);
      });

      document.querySelectorAll('.idrh').forEach(input => {
        actualizarPersona(input.closest('tr'), input.value);
      });

      mensaje(
        'Conexión correcta. Áreas: ' + areas.length +
        '. Colaboradores: ' + personas.length + '.'
      );
    })
    .withFailureHandler(err => {
      respondio = true;
      mensaje(
        'Error de Apps Script: ' +
        (err && err.message ? err.message : String(err))
      );
    })
    .obtenerCatalogos();
}


function opcionesAreas(seleccionada = '') {
  return '<option value="">Seleccionar área</option>' +
    areas.map(a => {
      const v = a.AreSup || '';
      const codigo = obtenerCodigoArea(v);

      return '<option value="' + esc(v) + '"' +
        (v === seleccionada ? ' selected' : '') + '>' +
        esc(codigo) + '</option>';
    }).join('');
}

function agregarFila() {
  const tr = document.createElement('tr');
  tr.innerHTML = `
  <td><input class="idrh" placeholder="Código"></td>
  <td><input class="nombre" readonly placeholder="Se busca en Maestro"></td>
  <td><select class="area">${opcionesAreas()}</select></td>
  <td><input class="inicio" type="time" value="06:00" required></td>
  <td><input class="fin" type="time" required></td>
  <td><input class="tallos" type="number" min="0" step="1" required></td>
  <td class="duracion">—</td>
  <td class="rendimiento">—</td>
  <td><button type="button" class="secondary quitar">Quitar</button></td>
  `;
  document.getElementById('rows').appendChild(tr);

  tr.querySelector('.idrh').addEventListener('change', e => {
    actualizarPersona(tr, e.target.value);
  });

  tr.querySelector('.quitar').addEventListener('click', () => tr.remove());

  ['inicio', 'fin', 'tallos'].forEach(clase => {
    tr.querySelector('.' + clase).addEventListener('input', () => calcularFila(tr));
  });
}

function actualizarPersona(tr, id) {
  const codigoBuscado = String(id || '').trim();
  const campoNombre = tr.querySelector('.nombre');

  if (!codigoBuscado) {
    campoNombre.value = '';
    campoNombre.title = '';
    return;
  }

  const persona = personas.find(p => {
    const codigo = String(
      p['Código'] ?? p['Codigo'] ?? p.codigo ?? ''
    ).trim();

    return codigo === codigoBuscado;
  });

  campoNombre.value = persona
    ? String(persona.Nombre ?? persona.nombre ?? '').trim()
    : '';

  campoNombre.title = campoNombre.value
    ? ''
    : 'Código no encontrado en la hoja Maestro: ' + codigoBuscado;

  if (!campoNombre.value) {
    mensaje(
      'No se encontró el código ' + codigoBuscado +
      ' en Maestro. Verifica el código y actualiza los catálogos.'
    );
  }

  calcularFila(tr);
}

function cargarRegistrosReconocidos(datos) {
  if (!datos || !Array.isArray(datos.registros)) {
    mensaje('La lectura no devolvió una lista de registros válida.');
    return;
  }

  const fechaInput = document.getElementById('fecha');
  const semanaInput = document.getElementById('sem');

  // Completar fecha y semana solo cuando tengan un formato válido.
  if (/^\d{4}-\d{2}-\d{2}$/.test(datos.fecha || '')) {
    fechaInput.value = datos.fecha;
  }

  if (/^\d{4}$/.test(String(datos.semana || ''))) {
    semanaInput.value = String(datos.semana);
  }

  if (datos.registros.length === 0) {
    mensaje('No se reconocieron colaboradores. Intenta con fotos más claras.');
    return;
  }

  // Evitar mezclar silenciosamente filas anteriores con la nueva lectura.
  if (document.querySelectorAll('#rows tr').length > 0) {
    const continuar = confirm(
      'La tabla ya contiene filas. ¿Deseas reemplazarlas con la nueva lectura?'
    );

    if (!continuar) {
      mensaje('Lectura recibida, pero no se modificó la tabla existente.');
      return;
    }
  }

  document.getElementById('rows').innerHTML = '';

  let pendientes = 0;

  datos.registros.forEach(registro => {
    agregarFila();

    const tr = document.querySelector('#rows tr:last-child');
    const codigo = String(registro.codigo || '').trim();

    tr.querySelector('.idrh').value = codigo;
    actualizarPersona(tr, codigo);

    const area = String(registro.area || '').trim().toUpperCase();
    const selectorArea = tr.querySelector('.area');

    const opcionArea = [...selectorArea.options].find(
      opcion => opcion.value.toUpperCase() === area
    );

    if (opcionArea) {
      selectorArea.value = opcionArea.value;
    } else if (area) {
      pendientes++;
      tr.title = 'Revisar área reconocida: ' + area;
    }

    const inicio = String(registro.horaInicio || '');
    const fin = String(registro.horaFin || '');

    if (/^\d{2}:\d{2}$/.test(inicio)) {
      tr.querySelector('.inicio').value = inicio;
    }

    if (/^\d{2}:\d{2}$/.test(fin)) {
      tr.querySelector('.fin').value = fin;
    }

    if (
      registro.tallos !== null &&
      registro.tallos !== '' &&
      Number.isInteger(Number(registro.tallos)) &&
      Number(registro.tallos) >= 0
    ) {
      tr.querySelector('.tallos').value = Number(registro.tallos);
    } else {
      pendientes++;
    }

    const observaciones = String(registro.observaciones || '').trim();

    if (
      !codigo ||
      !tr.querySelector('.nombre').value ||
      !opcionArea ||
      !fin ||
      registro.tallos === null ||
      observaciones
    ) {
      pendientes++;
      tr.title = [
        tr.title,
        observaciones
      ].filter(Boolean).join(' | ');
    }

    calcularFila(tr);
  });

  const fechaPendiente = !/^\d{4}-\d{2}-\d{2}$/.test(datos.fecha || '');
  const semanaPendiente = !/^\d{4}$/.test(String(datos.semana || ''));

  let resumen = 'Lectura terminada. Filas reconocidas: ' +
    datos.registros.length + '. Revisa todos los datos antes de guardar.';

  if (pendientes > 0 || fechaPendiente || semanaPendiente) {
    resumen += ' Hay datos pendientes o dudosos.';

    if (fechaPendiente) {
      resumen += ' Confirma la fecha de trabajo.';
    }

    if (semanaPendiente) {
      resumen += ' Confirma la semana de cuatro dígitos.';
    }

    resumen += ' Pasa el cursor sobre una fila para ver observaciones.';
  }

  mensaje(resumen);
}

function calcularFila(tr) {
  const inicio = tr.querySelector('.inicio').value;
  const fin = tr.querySelector('.fin').value;
  const valorTallos = tr.querySelector('.tallos').value;

  if (!inicio || !fin || valorTallos === '') {
    tr.querySelector('.duracion').textContent = '—';
    tr.querySelector('.rendimiento').textContent = '—';
    return;
  }

  const minutos = hora => {
    const partes = hora.split(':').map(Number);
    return partes[0] * 60 + partes[1];
  };

  const diferencia = minutos(fin) - minutos(inicio);
  const tallos = Number(valorTallos);

  if (diferencia <= 0 || !Number.isFinite(tallos) || tallos < 0) {
    tr.querySelector('.duracion').textContent = 'Revisar horas';
    tr.querySelector('.rendimiento').textContent = '—';
    return;
  }

  const duracion = diferencia / 60;

  tr.querySelector('.duracion').textContent = duracion.toFixed(2);
  tr.querySelector('.rendimiento').textContent =
    (tallos / duracion).toFixed(2);
}

function guardar() {
  const fecha = document.getElementById('fecha').value;
  const sem = document.getElementById('sem').value.trim();
  const filas = [...document.querySelectorAll('#rows tr')];

  if (!fecha || !sem || filas.length === 0) {
    mensaje('Indica la fecha, la semana y agrega al menos un colaborador.');
    return;
  }

  const registros = [];

  for (const tr of filas) {
    const id = tr.querySelector('.idrh').value.trim();
    const nombre = tr.querySelector('.nombre').value.trim();
    const area = tr.querySelector('.area').value;
    const inicio = tr.querySelector('.inicio').value;
    const fin = tr.querySelector('.fin').value;
    const tallos = tr.querySelector('.tallos').value;

    if (!id || !nombre || !area || !fin || tallos === '') {
      mensaje('Completa todos los campos de cada fila antes de guardar.');
      return;
    }

    if (Number(tallos) < 0 || !Number.isInteger(Number(tallos))) {
      mensaje('Total tallos debe ser un entero no negativo.');
      return;
    }

    registros.push({
      'Código': id,
      Colaborador: nombre,
      AreSup: area,
      Fecha: fecha,
      Sem: sem,
      'Hora Inicio': inicio,
      'Hora Fin': fin,
      'Total Tallos': Number(tallos)
    });
  }

  if (!confirm('Se enviarán ' + registros.length +
      ' registros a Rendimientos. ¿Confirmas que los revisaste?')) return;

  const btn = document.getElementById('save');
  btn.disabled = true;
  mensaje('Validando y guardando...');

  google.script.run
    .withSuccessHandler(res => {
      btn.disabled = false;
      mensaje('Registros guardados: ' + res.guardados);
      document.getElementById('rows').innerHTML = '';
    })
    .withFailureHandler(err => {
      btn.disabled = false;
      mensaje('No se guardaron los registros: ' + err.message);
    })
    .guardarRegistrosAprobados(registros);
}

document.getElementById('photos').addEventListener('change', e => {
  const cont = document.getElementById('photoPreview');
  cont.innerHTML = '';

  [...e.target.files].forEach(file => {
    const img = document.createElement('img');
    img.alt = file.name;
    img.title = file.name;
    img.src = URL.createObjectURL(file);
    cont.appendChild(img);
  });
});

cargarCatalogos();
agregarFila();
