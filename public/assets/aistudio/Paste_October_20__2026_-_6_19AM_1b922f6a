const ID_ARCHIVO = '1SgV5hv-Am41A18dt2uXl_Air0V_ttRGQxY7-NcvaXP0';
function obtenerCatalogos() {
  const ss = SpreadsheetApp.openById(ID_ARCHIVO);
  const hojaAreas = ss.getSheetByName('Area');
  const hojaMaestro = ss.getSheetByName('Maestro');
  const hojaRendimientos = ss.getSheetByName('Rendimientos');

  if (!hojaAreas) {
    throw new Error('No se encontró la hoja Área.');
  }

  if (!hojaMaestro) {
    throw new Error('No se encontró la hoja Maestro.');
  }

  if (!hojaRendimientos) {
    throw new Error('No se encontró la hoja Rendimientos.');
  }

  // Leer áreas, productos y sedes.
  const datosAreas = hojaAreas.getDataRange().getDisplayValues();
  const encabezadosAreas = datosAreas[0].map(v =>
    String(v).trim()
  );

  const indiceAreSup = encabezadosAreas.indexOf('AreSup');
  const indiceProducto = encabezadosAreas.indexOf('Producto');
  const indiceSede = encabezadosAreas.indexOf('Sede');

  if (
    indiceAreSup === -1 ||
    indiceProducto === -1 ||
    indiceSede === -1
  ) {
    throw new Error(
      'La hoja Área debe tener los encabezados AreSup, Producto y Sede.'
    );
  }

  const areas = datosAreas.slice(1)
    .filter(fila => fila[indiceAreSup])
    .map(fila => ({
      AreSup: String(fila[indiceAreSup]).trim(),
      Producto: String(fila[indiceProducto]).trim(),
      Sede: String(fila[indiceSede]).trim()
    }));

  // Leer colaboradores e IDs de RH.
  const datosMaestro = hojaMaestro.getDataRange().getDisplayValues();
  const encabezadosMaestro = datosMaestro[0].map(v =>
    String(v).trim()
  );

  const indiceID = encabezadosMaestro.indexOf('Código');
  const indiceNombre = encabezadosMaestro.indexOf('Nombre');

  if (indiceID === -1 || indiceNombre === -1) {
    throw new Error(
      'La hoja Maestro debe tener los encabezados Código y Nombre.'
    );
  }

  const colaboradores = datosMaestro.slice(1)
    .filter(fila => fila[indiceID] && fila[indiceNombre])
    .map(fila => ({
      'Código': String(fila[indiceID]).trim(),
      Nombre: String(fila[indiceNombre]).trim()
    }));

  const encabezadosRendimientos =
    hojaRendimientos.getRange(
      1, 1, 1, hojaRendimientos.getLastColumn()
    ).getDisplayValues()[0];

  return {
    areas: areas,
    colaboradores: colaboradores,
    encabezadosRendimientos: encabezadosRendimientos
  };
}

/**
 * Lee fotografías de formatos manuscritos con Gemini.
 * Recibe imágenes en base64 desde Index.html.
 * No guarda información en Google Sheets.
 */

function leerFotografiasGemini(imagenes) {
  const apiKey = PropertiesService
    .getScriptProperties()
    .getProperty('GEMINI_API_KEY');

  if (!apiKey) {
    throw new Error(
      'No se encontró GEMINI_API_KEY en las propiedades del script.'
    );
  }

  if (!Array.isArray(imagenes) || imagenes.length === 0) {
    throw new Error('Selecciona al menos una fotografía.');
  }

  if (imagenes.length > 6) {
    throw new Error(
      'Por ahora puedes procesar máximo 6 fotografías por lectura.'
    );
  }

  const partes = [{
    text: `
Analiza las fotografías de formatos manuscritos de rendimiento de corte
de flores y devuelve exclusivamente un objeto JSON válido.

La estructura requerida es:
{
  "semana": "",
  "fecha": "",
  "registros": [
    {
      "codigo": "",
      "area": "",
      "horaInicio": "",
      "horaFin": "",
      "tallos": null,
      "observaciones": ""
    }
  ]
}

Instrucciones:
- "semana": código de cuatro dígitos, por ejemplo 2641.
- "fecha": fecha de trabajo en formato AAAA-MM-DD.
- La semana usa el calendario de domingo a sábado.
- Si la fecha no se distingue con seguridad, devuelve "".
- Lee un registro por cada colaborador visible en el formato.
- "codigo": código o ID RH del colaborador; no inventes dígitos.
- "area": código del área, por ejemplo F1, F2, GYPSO o R1.
- "horaInicio" y "horaFin": formato HH:mm de 24 horas.
- Si la hora inicial no está escrita o no se puede leer, usa "06:00"
  y explica en "observaciones" que se asumió esa hora.
- "tallos": número entero. Si no se puede leer con seguridad, devuelve null.
- Si un dato es dudoso, deja ese campo vacío o usa null, y explica
  la duda en "observaciones".
- No inventes nombres ni códigos de colaboradores.
- No incluyas filas de títulos, totales generales ni filas vacías.
- No calcules ni inventes el rendimiento por hora.
- Si aparecen varias fotografías del mismo formato, evita duplicar
  registros que sean claramente la misma persona y el mismo dato.
- Si las fotografías tienen fechas diferentes, no mezcles los datos:
  indícalo en "observaciones" y deja "fecha" vacía.
- Devuelve únicamente JSON, sin bloques Markdown ni explicaciones.
`
  }];

  imagenes.forEach((imagen, indice) => {
    if (!imagen || !imagen.data || !imagen.mimeType) {
      throw new Error(
        'La fotografía número ' + (indice + 1) +
        ' no tiene un formato válido.'
      );
    }

    const mimeType = String(imagen.mimeType).toLowerCase();

    if (![
      'image/jpeg',
      'image/png',
      'image/webp',
      'image/heic',
      'image/heif'
    ].includes(mimeType)) {
      throw new Error(
        'Formato de imagen no admitido en la fotografía ' +
        (indice + 1) + '.'
      );
    }

    partes.push({
      inline_data: {
        mime_type: mimeType,
        data: imagen.data
      }
    });
  });

const url =
  'https://generativelanguage.googleapis.com/v1beta/models/gemini-3.6-flash:generateContent';

  const payload = JSON.stringify({
    contents: [{
      role: 'user',
      parts: partes
    }],
    generationConfig: {
      responseMimeType: 'application/json',
      temperature: 0.1,
      maxOutputTokens: 8192
    }
  });

  let respuesta;
  let codigoHTTP = 0;
  let textoRespuesta = '';

  // Reintentar solo ante errores temporales del servicio.
  const maxIntentos = 3;
  const erroresTemporales = [429, 500, 502, 503, 504];

  for (let intento = 1; intento <= maxIntentos; intento++) {
    respuesta = UrlFetchApp.fetch(url, {
      method: 'post',
      contentType: 'application/json',
      headers: {
        'x-goog-api-key': apiKey
      },
      payload: payload,
      muteHttpExceptions: true
    });

    codigoHTTP = respuesta.getResponseCode();
    textoRespuesta = respuesta.getContentText();

    if (codigoHTTP >= 200 && codigoHTTP < 300) {
      break;
    }

    if (!erroresTemporales.includes(codigoHTTP)) {
      throw new Error(
        'Gemini respondió con error (' + codigoHTTP + '): ' +
        textoRespuesta.substring(0, 700)
      );
    }

    if (intento < maxIntentos) {
      // Esperar 2 segundos y luego 4 segundos.
      Utilities.sleep(2000 * Math.pow(2, intento - 1));
    }
  }

  if (codigoHTTP < 200 || codigoHTTP >= 300) {
    throw new Error(
      'Gemini continúa temporalmente ocupado después de ' +
      maxIntentos + ' intentos (error ' + codigoHTTP + '). ' +
      'Espera un minuto e inténtalo de nuevo. Detalle: ' +
      textoRespuesta.substring(0, 400)
    );
  }

  let resultado;

  try {
    resultado = JSON.parse(textoRespuesta);
  } catch (error) {
    throw new Error('Gemini devolvió una respuesta que no es JSON válido.');
  }

  const texto = resultado.candidates &&
    resultado.candidates[0] &&
    resultado.candidates[0].content &&
    resultado.candidates[0].content.parts
      .map(parte => parte.text || '')
      .join('');

  if (!texto) {
    const motivo = resultado.candidates &&
      resultado.candidates[0] &&
      resultado.candidates[0].finishReason;

    throw new Error(
      'Gemini no devolvió datos legibles. ' +
      'Motivo: ' + (motivo || 'respuesta vacía') +
      '. Intenta con fotografías más claras o menos imágenes.'
    );
  }

  let datos;

  try {
    datos = JSON.parse(texto);
  } catch (error) {
    throw new Error(
      'La respuesta de lectura no tiene un formato válido. Intenta nuevamente.'
    );
  }

  if (!Array.isArray(datos.registros)) {
    throw new Error(
      'La lectura no devolvió una lista válida de registros.'
    );
  }

  return datos;
}



